# =========================================================
# CadorDigital Backend — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate secrets with:  openssl rand -hex 64
# =========================================================

PORT=5000
NODE_ENV=development

# PostgreSQL connection string (localhost dev example)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cador_digital

REDIS_URL=redis://localhost:6379

# Use different, randomly-generated secrets per environment
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Initial admin account (seed) — change after first login via Settings
ADMIN_EMAIL=admin@cador.digital
ADMIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@cador.digital

# Cloudinary media storage
# REQUIRED in production: without these, uploads fall back to local disk,
# which is EPHEMERAL on Render (files are lost on every redeploy/restart).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

FRONTEND_URL=http://localhost:3000
